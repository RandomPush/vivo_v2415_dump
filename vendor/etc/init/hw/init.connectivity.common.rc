# MTK connectivity .rc configure

on post-fs-data


#
# Connectivity related device nodes & configuration (begin)
#

#/dev/ttyMT2 for Connectivity BT/FM/GPS usage
    chmod 0660 /dev/ttyMT2
    chown system system /dev/ttyMT2

#/dev/ttyMT1 for GPS 3337 usage
    chmod 0660 /dev/ttyMT1
    chown system system /dev/ttyMT1

# GPS
    mkdir /data/vendor/gps 0770 gps system
    mkdir /data/vendor/log 0770 gps system
    mkdir /data/vendor/log/gps 0770 gps system

# GPS EMI
    chmod 0660 /dev/gps_emi

# WiFi
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# BT relayer mode used VCOM
    chown bluetooth bluetooth /dev/ttyGS2
    chmod 0660 /dev/ttyGS2

#
# Connectivity related device nodes & configuration (end)
#


on boot

#
# Connectivity related services (Begin)
#
# GPS
service mnld /vendor/bin/mnld
    class main
    user gps
    capabilities WAKE_ALARM
    group gps inet misc sdcard_rw sdcard_r media_rw system radio wakelock
    socket mnld stream 660 gps system

service gnss_daemon /vendor/bin/gnss_daemon
    class main
    user gps
    group gps inet misc sdcard_rw sdcard_r media_rw system radio wakelock
    socket gnss_daemon stream 660 gps system

on property:persist.vendor.em.dy.debug=1
    stop lbs_dbg

# vivo duxiaolei add support of mtk_circu_log begin
service start_circ_wlan_logs /system/bin/collect_wlan_logs.sh onoff
    class main
    user shell
    group root system shell wifi log
    disabled
    oneshot

on property:persist.sys.circulated_wlan_logs=*
    start start_circ_wlan_logs
# vivo duxiaolei add support of mtk_circu_log end

# vivo mazhuangzhuang add for mtk_circu_log
service collect_wlan_logs /system/bin/collect_wlan_logs.sh
    class main
    user root
    group root system shell wifi log
    disabled
    oneshot

# vivo liuyang add for WIFI begin
on property:sys.boot_completed=1
    write /proc/sys/net/ipv4/tcp_mtu_probing 1
    write /proc/sys/net/ipv4/tcp_timestamps 2
    write /dev/kmsg "write tcp_mtu_probing 1 and tcp_timestamps to 2"
# vivo liuyang add for WIFI end

# vivo liuyang add for set chain begin
on property:vendor.all.modules.ready=1
    write /dev/kmsg "reset chainValue to MIMO when all.modules.ready"
    setprop persist.sys.wlan.chain MIMO

on property:persist.sys.wlan.chain=*
    chown system system /sys/module/wlan_drv_${ro.vendor.wlan.gen}/parameters/chainValue
    chmod 0777 /sys/module/wlan_drv_${ro.vendor.wlan.gen}/parameters/chainValue
    write /sys/module/wlan_drv_${ro.vendor.wlan.gen}/parameters/chainValue ${persist.sys.wlan.chain}
    write /dev/kmsg "set chainValue to ${persist.sys.wlan.chain}"
# vivo liuyang add for set chain end

# vivo lanyonghui add for bsp full scan begin
on property:sys.boot_completed=1
    write /dev/kmsg "reset bspFullScan to 0"
    setprop persist.vivo.bsptest_wifi_full_channel 0

on property:persist.vivo.bsptest_wifi_full_channel=*
    chown system system /sys/module/wlan_drv_${ro.vendor.wlan.gen}/parameters/bspFullScan
    chmod 0777 /sys/module/wlan_drv_${ro.vendor.wlan.gen}/parameters/bspFullScan
    write /sys/module/wlan_drv_${ro.vendor.wlan.gen}/parameters/bspFullScan ${persist.vivo.bsptest_wifi_full_channel}
    write /dev/kmsg "set bspFullScan to ${persist.vivo.bsptest_wifi_full_channel}"
# vivo lanyonghui add for bsp full scan end

#service BGW /vendor/bin/BGW
