# MTK platform .rc configure
on post-fs-data
    # calibration
    mkdir /data/vendor/sensor 0774 system system
    # Sensor
    #chmod 0660 /dev/hf_manager
    #chown system system /dev/hf_manager

on boot
    chmod 0774 /mnt/vendor/nvcfg/sensor
    chown system system /mnt/vendor/nvcfg/sensor/gyro_internal_freq
    chown system system /mnt/vendor/nvcfg/sensor/gyro_freq
    chmod 0774 /mnt/vendor/nvcfg/sensor/gyro_internal_freq
    chmod 0774 /mnt/vendor/nvcfg/sensor/gyro_freq