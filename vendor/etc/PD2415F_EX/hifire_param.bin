ainr_str                    0.5   //AI based wind noise reduction strength

wnd_vol_init                -70   // smooth volume starting point
wnd_vol_alpha               0.99  // alpha for smoothing volume
wnd_vol_sil                 -65   // volume threshold for detect silence
wnd_vol_noisy               -30   // volume threshold for detect noisy
wnd_chi_initsft             10    // shift for smooth_chi
wnd_chi_alpha               0.99  // alpha for smooth_chi
wnd_chival_sil              21    // cliiped chisqr val when volume < wnd_vol_thd
wnd_vol_thd                 -65   // smooth volume thd for detect silence, update chisqr with wnd_chival_sil
wnd_on_sil                  180   // WND on: when volume < wnd_vol_sil                & smooth_chi >wnd_vol_sil
wnd_on_nrml                 60    // WND on: (wnd_vol_sil) < volume < (wnd_vol_noisy) & smooth_chi >wnd_on_nrml
wnd_on_noisy                30    // WND on: volume > (wnd_vol_noisy)                 & smooth_chi >wnd_on_noisy
swnd_on_nrml                20    // (small-wind-detect) WND on: (wnd_vol_sil) < volume < (wnd_vol_noisy) & smooth_chi >swnd_on_nrml
swnd_on_large               10    // (small-wind-detect) WND on: volume > (wnd_vol_noisy)              
wnd_largew_counter          6000 

wnr_str                     0.5   //AI based wind noise reduction strength
wnd_th_nsd                  0.42  //NSOFF wind detect threshold
wnd_th_nse                  0.42  //NSON wind detect threshold
cng_noise_str               11.0 //comfort noise strength
cng_wind_bound             -67.0 //wind scenario comfort noise max bound (dB)
cng_norm_bound             -100.0 //norm scenario comfort noise max bound (dB)
cng_attack                  210.0 //cng attack time (ms)
cng_release                 21.0 //cng release time (ms)

