        <!-- 平均亮度阈值小于xx，按0-1来计算 -->
        <M2PixelAvg>0.2</M2PixelAvg>
        <!-- 暗区的阈值定义 -->
        <M2BlackAvg>0.025</M2BlackAvg>
        <!-- 暗区占比大于xx，按0-1来计算 -->
        <M2BlackRatio>0.8</M2BlackRatio>
        <!-- 打开GIC -->
        <GIC>0</GIC>
    </DenoiserBranch>
