<?xml version="1.0" encoding="utf-8"?>
<CartoonPt version="1.5.8">
    <!--算法运行框架(勿改)-->
    <FrameWork>vdnn</FrameWork>
	<!--模型所在平台名字-->
	<Platform>MTK6985</Platform>
	
	<!--应用场景1日漫-->
	<riman>
		<!--相机预览场景-->
		<preview>
			<!--女性脸模型信息-->
			<faceGenFemale>
				<ModelPath>/vendor/camera3rd/nti/riman_ffgenp.vdnn</ModelPath>
				<input_node>input_0</input_node>
				<output_node>conv_bn_re_lu2d_49</output_node>
				<!--模型推理引擎类型类型-->
				<engine_type>7</engine_type>				
				<!--模型输入数据类型-->
				<input_data_type>2</input_data_type>
				<!--模型输出数据类型-->
				<output_data_type>2</output_data_type>
				<!--运行硬件类型0(cpu)1(gpu)-->
				<Device>0</Device> 
				<!--类型为0时设置线程数-->
				<threads>1</threads>
				<!--类型为档次数值0-10-->
				<Powerlevel>0</Powerlevel> 								
			</faceGenFemale>	
			<!--男性脸模型信息-->
			<faceGenMale>
				<ModelPath>/vendor/camera3rd/nti/riman_mfgenp.vdnn</ModelPath>
				<input_node>input_0</input_node>
				<output_node>conv_bn_re_lu2d_49</output_node>
				<!--模型推理引擎类型类型-->
				<engine_type>7</engine_type>				
				<!--模型输入数据类型-->
				<input_data_type>2</input_data_type>
				<!--模型输出数据类型-->
				<output_data_type>2</output_data_type>
				<!--运行硬件类型0(cpu)1(gpu)-->
				<Device>0</Device> 
				<!--类型为0时设置线程数-->
				<threads>1</threads>
				<!--类型为档次数值0-10-->
				<Powerlevel>0</Powerlevel> 								
			</faceGenMale>		
			<!--最大人脸个数-->
			<maxFaceNum>1</maxFaceNum>		
		</preview>
		<outlineConfithredhold>
			<eye_left>0.25</eye_left>
			<eye_right>0.25</eye_right>
		</outlineConfithredhold>		
	</riman>

	<!--应用场景2水彩-->
	<watercolour>
		<!--相机预览场景-->
		<preview>
			<!--人脸模型信息-->
			<faceGen>
				<ModelPath>/vendor/camera3rd/nti/watercolour_fggenp.vdnn</ModelPath>
				<input_node>input_0</input_node>
				<output_node>conv_bn_re_lu2d_49</output_node>
				<!--模型推理引擎类型类型-->
				<engine_type>7</engine_type>				
				<!--模型输入数据类型-->
				<input_data_type>2</input_data_type>
				<!--模型输出数据类型-->
				<output_data_type>2</output_data_type>
				<!--运行硬件类型0(cpu)1(gpu)-->
				<Device>0</Device> 
				<!--类型为0时设置线程数-->
				<threads>1</threads>
				<!--类型为档次数值0-10-->
				<Powerlevel>0</Powerlevel>
				<!--性别检测, 0 关闭, 1 开启-->
				<Gendercls>1</Gendercls> 								
			</faceGen>		
			<!--最大人脸个数-->
			<maxFaceNum>1</maxFaceNum>		
		</preview>
		<outlineConfithredhold>
			<eye_left>0.25</eye_left>
			<eye_right>0.25</eye_right>
		</outlineConfithredhold>				
	</watercolour>

	<!--应用场景3迪士尼-->
	<disney>
		<!--相机预览场景-->
		<preview>
			<!--女性脸模型信息-->
			<faceGenFemale>
				<ModelPath>/vendor/camera3rd/nti/disney_ffgenp.vdnn</ModelPath>
				<input_node>input_0</input_node>
				<output_node>conv_bn_re_lu2d_49</output_node>
				<!--模型推理引擎类型类型-->
				<engine_type>7</engine_type>				
				<!--模型输入数据类型-->
				<input_data_type>2</input_data_type>
				<!--模型输出数据类型-->
				<output_data_type>2</output_data_type>
				<!--运行硬件类型0(cpu)1(gpu)-->
				<Device>0</Device> 
				<!--类型为0时设置线程数-->
				<threads>1</threads>
				<!--类型为档次数值0-10-->
				<Powerlevel>0</Powerlevel> 		
				<!--性别检测, 0 关闭, 1 开启-->
				<Gendercls>1</Gendercls>		 				
			</faceGenFemale>	
			<!--男性脸模型信息-->
			<faceGenMale>
				<ModelPath>/vendor/camera3rd/nti/disney_mfgenp.vdnn</ModelPath>
				<input_node>input_0</input_node>
				<output_node>conv_bn_re_lu2d_49</output_node>
				<!--模型推理引擎类型类型-->
				<engine_type>7</engine_type>				
				<!--模型输入数据类型-->
				<input_data_type>2</input_data_type>
				<!--模型输出数据类型-->
				<output_data_type>2</output_data_type>
				<!--运行硬件类型0(cpu)1(gpu)-->
				<Device>0</Device> 
				<!--类型为0时设置线程数-->
				<threads>1</threads>
				<!--类型为档次数值0-10-->
				<Powerlevel>0</Powerlevel> 
				<!--性别检测, 0 关闭, 1 开启-->
				<Gendercls>1</Gendercls>
			</faceGenMale>		
			<!--最大人脸个数-->
			<maxFaceNum>1</maxFaceNum>
			<netInputBlur>1</netInputBlur>
		</preview>
		<outlineConfithredhold>
			<eye_left>0.25</eye_left>
			<eye_right>0.25</eye_right>
		</outlineConfithredhold>				
	</disney>

    <!--参数bin路径-->
    <binPath>/vendor/camera3rd/nti/CartoonParam.bin</binPath>
    <!--bin参数对象,可以采用数字对应-->
	<binObj>lut_riman_capture lut_watercolour_lipcolor lut_riman_preview lut_watercolour_preview lut_disney_capture</binObj>	      
	<!--最小人脸处理面积比例-->
	<minFaceAreaRate>0.05</minFaceAreaRate>    
	<!--关键点拟合椭圆参数-->
	<ellipse>
		<ShortAxisRatio>1.28</ShortAxisRatio>
		<UpLongAxisRatio>0.88</UpLongAxisRatio>
		<DownLongAxisRatio>1.1</DownLongAxisRatio>
		<MaskErodeRate>0.9</MaskErodeRate>
	</ellipse>
</CartoonPt>
