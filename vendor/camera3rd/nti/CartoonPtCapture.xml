<?xml version="1.0" encoding="utf-8"?>
<CartoonPt version="1.5.8">
    <!--算法运行框架(勿改)-->
    <FrameWork>vdnn</FrameWork>
	<!--模型所在平台名字-->
	<Platform>MTK6989</Platform>
	
	<!--应用场景1日漫-->
	<riman>
		<!--相机拍照场景-->
		<capture>
			<!--人脸模型信息-->
			<faceGen>
				<ModelName>riman_fggenc.vdnn</ModelName>
				<ModelVersion>V1.0.0</ModelVersion>
				<ModelMD5>ba7e2d40a0dc0fc6f830f0f48c6d6167</ModelMD5>
				<input_node>input_0</input_node>
				<output_node>conv_bn_re_lu2d_95</output_node>
				<!--模型推理引擎类型类型-->
				<engine_type>7</engine_type>				
				<!--模型输入数据类型-->
				<input_data_type>3</input_data_type>
				<!--模型输出数据类型-->
				<output_data_type>3</output_data_type>
				<!--运行硬件类型0(cpu)1(gpu)-->
				<Device>0</Device> 
				<!--类型为0时设置线程数-->
				<threads>1</threads>
				<!--类型为档次数值0-10-->
				<Powerlevel>10</Powerlevel> 
				<!--性别检测, 0 关闭, 1 开启-->
				<Gendercls>1</Gendercls>												
			</faceGen>	
			<!--背景模型信息-->
			<bgGen>
				<ModelName>riman_bggenc.vdnn</ModelName>
				<ModelVersion>V1.0.0</ModelVersion>
				<ModelMD5>fb18cd531577d986140c3ec554a82a7f</ModelMD5>
				<input_node>input_0</input_node>
				<output_node>conv_bn_re_lu2d_96</output_node>
				<!--模型推理引擎类型类型-->
				<engine_type>7</engine_type>				
				<!--模型输入数据类型-->
				<input_data_type>3</input_data_type>
				<!--模型输出数据类型-->
				<output_data_type>3</output_data_type>
				<!--运行硬件类型0(cpu)1(gpu)-->
				<Device>0</Device> 
				<!--类型为0时设置线程数-->
				<threads>1</threads>
				<!--类型为档次数值0-10-->
				<Powerlevel>10</Powerlevel> 								
			</bgGen>
			<!--最大人脸个数-->
			<maxFaceNum>3</maxFaceNum>
		</capture>
		<outlineConfithredhold>
			<eye_left>0.25</eye_left>
			<eye_right>0.25</eye_right>
		</outlineConfithredhold>		
	</riman>

