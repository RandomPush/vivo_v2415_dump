<?xml version="1.0" encoding="utf-8"?>
<!--mapping_rule="0000000044443333000000004444333311111111111111112222222222222222" 表示0~63的对应映射值分别对应00...222，每一位必须为正整数值-->
<!--0~63位对应的数值由天线工程师发的工作联络单里的表格最后一列"SCEN_IDX"值组成-->
<!--当product存在相同项时，使用最上面的<product></product>一项配置，其后的相同项不生效-->
<config>
    <product model="PD2405">
        <item hardware_id="1" mapping_rule="0000000044443333000000004444333311111111111111112222222222222222" />
    </product>
    <product model="PD2415">
        <item hardware_id="1" mapping_rule="0000000044443333000000004444333311111111111111112222222222222222" />
    </product>
    <product model="PD2419">
        <item hardware_id="1" mapping_rule="0000000000001111000000000000111100000000000000000000000000000000" />
    </product>
</config>