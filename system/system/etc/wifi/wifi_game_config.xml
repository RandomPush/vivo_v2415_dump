    <AiPredictionPlatforms>
        <item>SM8450</item>
        <item>SM8475</item>
        <item>SM8550</item>
        <item>SM8650</item>
        <item>SM8635</item>
        <item>SM8750</item>
        <item>SM7550</item>
        <item>MTK6989</item>
        <item>MTK6991</item>
